{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": [
    "**/*.cjs",
    "**/*.js",
    "**/*.mjs",
    "**/*.ts",
    ".lintstagedrc.js",
    ".prettierrc.cjs"
  ],
  "exclude": ["dist/**/*", "scripts", "coverage/**/*", "node_modules"]
}
