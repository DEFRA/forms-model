{
  "name": "@defra/forms-model",
  "version": "4.0.1",
  "description": "A hapi plugin providing the model for Defra forms",
  "homepage": "https://github.com/DEFRA/forms-model#readme",
  "types": "dist/types/index.d.ts",
  "main": "dist/module/index.js",
  "exports": {
    ".": {
      "import": "./dist/module/index.js",
      "default": "./dist/module/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./stubs": {
      "import": "./dist/module/stubs.js",
      "default": "./dist/module/stubs.js",
      "types": "./dist/types/stubs.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEFRA/forms-model.git"
  },
  "license": "OGL-UK-3.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "npm run build:types && npm run build:node && npm run build:schemas",
    "build:node": "babel --delete-dir-on-start --extensions \".ts,.js\" --ignore \"**/*.test.*\" --copy-files --no-copy-ignored --source-maps --out-dir ./dist/module ./src",
    "build:types": "tsc --build --force tsconfig.build.json && tsc-alias --project tsconfig.build.json",
    "build:schemas": "node scripts/generate-schemas.js",
    "format": "npm run format:check -- --write",
    "format:check": "prettier --cache --cache-location .cache/prettier --cache-strategy content --check \"**/*.{cjs,js,json,md,mjs,ts}\"",
    "lint": "npm run lint:editorconfig && npm run lint:js && npm run lint:types",
    "lint:editorconfig": "editorconfig-checker",
    "lint:fix": "npm run lint:js -- --fix",
    "lint:js": "eslint --cache --cache-location .cache/eslint --cache-strategy content --color .",
    "lint:types": "tsc --build tsconfig.json",
    "prepare": "husky || true",
    "test": "jest --color --coverage --verbose",
    "test:changed": "jest --coverage --changedSince=origin/main --coverageReporters=text",
    "test:watch": "jest --color --watch"
  },
  "dependencies": {
    "@joi/date": "^3.0.0",
    "marked": "^15.0.12",
    "nanoid": "^5.0.7",
    "slug": "^11.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.1.0",
    "@types/slug": "^5.0.9",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.27.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-replace-import-extension": "^1.1.5",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "editorconfig-checker": "^6.2.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsdoc": "^63.0.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "joi": "^18.2.9",
    "joi-to-json": "^4.3.2",
    "lint-staged": "^17.0.7",
    "neostandard": "^0.12.2",
    "prettier": "^3.8.3",
    "tsc-alias": "^1.8.11",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.56.1"
  },
  "peerDependencies": {
    "joi": "^18.0.0"
  },
  "engines": {
    "node": "^24.19.0",
    "npm": "^11.17.0 || >=12.0.2"
  },
  "allowScripts": {
    "unrs-resolver": true
  }
}
